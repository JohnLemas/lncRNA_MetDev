#!/bin/bash --login
#SBATCH --job-name=feelnc_filter
#SBATCH --cpus-per-task=20
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/g.max/logs/%x_%j.out

# 1. Paths
BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"
IMAGE="${BASE}/images/FEELnc2.sif"
INPUT_GTF="${BASE}/g.max/03_outputs/04_stringtie/g.max_candidates.gtf"
REF_ANN="${BASE}/g.max/01_inputs/g.max_mRNA.gtf"
OUTPUT_DIR="${BASE}/g.max/03_outputs/05_FEELnc"
OUTPUT_GTF="${BASE}/g.max/03_outputs/05_FEELnc/g.max_FEELnc.gtf"
FEELNC_DIR="${BASE}/scripts/feelnc"

mkdir -p $OUTPUT_DIR

# 2. Run it
singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    env PERL5LIB="${FEELNC_DIR}/lib" \
    perl ${FEELNC_DIR}/scripts/FEELnc_filter.pl \
    -i $INPUT_GTF \
    -a $REF_ANN \
    --monoex=-1 -s 200 -p 20 > $OUTPUT_GTF

echo "FEELnc filtering complete."
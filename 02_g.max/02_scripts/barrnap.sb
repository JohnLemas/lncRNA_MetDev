#!/bin/bash --login
#SBATCH --job-name=barrnap_custom_db
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/g.max/logs/sortmerna/%x_%j.out

set -euo pipefail

# ----------------------------------------------------------------------------
# USER-CONFIGURABLE SETTINGS
# ----------------------------------------------------------------------------

SIF=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/images/sortmerna.sif
GENOME=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/g.max/01_inputs/g.max.chromosomes.fa

KINGDOMS=(bac euk mito)

OUTDIR=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/databases/g.max_barrnap
mkdir -p "${OUTDIR}"

THREADS=${SLURM_CPUS_PER_TASK:-8}
CDHIT_IDENTITY=0.97

COMBINED_FASTA="${OUTDIR}/combined_rrna.fasta"
CUSTOM_DB="${OUTDIR}/custom_db.fasta"
INDEX_DIR="${OUTDIR}/idx"

# ----------------------------------------------------------------------------
# STEP 1: Run barrnap on the genome, once per kingdom, via the image
# ----------------------------------------------------------------------------

filename=$(basename "${GENOME}")
name="${filename%.*}"
GENOME_DIR=$(dirname "${GENOME}")

echo "[$(date)] Running barrnap for kingdoms: ${KINGDOMS[*]} on ${GENOME}"

KINGDOM_FASTAS=()

for kingdom in "${KINGDOMS[@]}"; do
    echo "  -> ${name} [${kingdom}]"
    
    out_fasta="${OUTDIR}/${name}_${kingdom}_rrna.fasta"
    KINGDOM_FASTAS+=("${out_fasta}")

    singularity exec -B "${GENOME_DIR}:${GENOME_DIR}" -B "${OUTDIR}:${OUTDIR}" "${SIF}" \
        barrnap \
            --kingdom "${kingdom}" \
            --threads "${THREADS}" \
            --outseq "${out_fasta}" \
            "${GENOME}" \
        > "${OUTDIR}/${name}_${kingdom}_rrna.gff"
done

# ----------------------------------------------------------------------------
# STEP 2: Concatenate all per-kingdom rRNA FASTA outputs
# ----------------------------------------------------------------------------

echo "[$(date)] Concatenating per-kingdom rRNA FASTA files"
cat "${KINGDOM_FASTAS[@]}" > "${COMBINED_FASTA}"

n_seqs=$(grep -c '^>' "${COMBINED_FASTA}" || true)
echo "  Combined FASTA contains ${n_seqs} sequences"

if [ "${n_seqs}" -eq 0 ]; then
    echo "ERROR: no rRNA sequences were predicted. Check barrnap logs before proceeding." >&2
    exit 1
fi

# ----------------------------------------------------------------------------
# STEP 3: Dereplicate/cluster with cd-hit-est
# ----------------------------------------------------------------------------

echo "[$(date)] Loading cd-hit module"
ml purge
ml load CD-HIT

echo "[$(date)] Clustering combined FASTA at ${CDHIT_IDENTITY} identity"
cd-hit-est \
    -i "${COMBINED_FASTA}" \
    -o "${CUSTOM_DB}" \
    -c "${CDHIT_IDENTITY}" \
    -n 10 \
    -M $((16 * 1024)) \
    -T "${THREADS}" \
    -d 0

ml purge

# ----------------------------------------------------------------------------
# STEP 4: Index the custom database with SortMeRNA
# ----------------------------------------------------------------------------

echo "[$(date)] Indexing custom rRNA database for SortMeRNA"
mkdir -p "${INDEX_DIR}"

singularity exec -B "${OUTDIR}:${OUTDIR}" "${SIF}" \
    sortmerna \
        --ref "${CUSTOM_DB}" \
        --idx-dir "${INDEX_DIR}" \
        --index 1 \
        --task 5 \
        --threads "${THREADS}"

echo "[$(date)] Done. Indexed database available at:"
echo "  FASTA: ${CUSTOM_DB}"
echo "  Index directory: ${INDEX_DIR}"
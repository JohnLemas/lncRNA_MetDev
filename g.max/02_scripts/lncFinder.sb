#!/bin/bash --login
#SBATCH --job-name=lncFinder
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/g.max/logs/%x_%j.out

# Paths
BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"
IMAGE="${BASE}/images/rbio_tools_dev.sif"
OUTPUT_DIR="${BASE}/g.max/03_outputs/08_lncFinder"
INPUT_FASTA="${BASE}/g.max/03_outputs/04_stringtie/g.max_candidates.fasta"
OUTPUT_CSV="${OUTPUT_DIR}/g.max_lncFinder_results.csv"

mkdir -p ${OUTPUT_DIR}

#lncFinder model designation: wheat, human, mouse
MODEL_TYPE="wheat"

mkdir -p $OUTPUT_DIR

echo "=========================================================="
echo "Starting LncFinder Matrix Processing"
echo "Job ID: $SLURM_JOB_ID"
echo "Allocated Cores: $SLURM_CPUS_PER_TASK"
echo "Allocated Memory: $SLURM_MEM_PER_NODE MB"
echo "Selected Model: $MODEL_TYPE"
echo "=========================================================="
date

# Run the unified R script inside the container
singularity run \
    --bind /mnt/scratch/lemasjoh \
    "$IMAGE" lnc_predict \
    --fasta "$INPUT_FASTA" \
    --out "$OUTPUT_CSV" \
    --cores "$SLURM_CPUS_PER_TASK" \
    --model "$MODEL_TYPE"

EXIT_CODE=$?

echo "=========================================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "PIPELINE FINISHED SUCCESSFULLY"
else
    echo "PIPELINE FAILED WITH EXIT CODE $EXIT_CODE"
fi
echo "=========================================================="
date

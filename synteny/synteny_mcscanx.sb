#!/bin/bash --login
#SBATCH --job-name=synteny_all
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=23:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/repo/synteny/logs/%x_%j.out
#SBATCH --error=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/repo/synteny/logs/%x_%j.err

# Multi-species synteny (MCScanX): per-species prep, then all pairwise comparisons.
# Needs, for EACH species, the datasets_cleanup.sb deliverables in $BASE/<SPEC>/01_inputs:
#   <SPEC>.chromosomes.fa   nuclear assembly
#   <SPEC>_mRNA.gtf         mRNA-only annotation
# Per-species files -> $BASE/synteny/species/<SPEC>/   (<SPEC>.prot.fa, <SPEC>.gff)
# Per-pair files    -> $BASE/synteny/<SP1>_vs_<SP2>/   (key output: <CODE1>_<CODE2>.collinearity)
# Already finished steps are skipped; set FORCE=1 to redo everything.
# NOTE: the logs directory must exist before sbatch:  mkdir -p $BASE/synteny/logs

set -euo pipefail
export LC_ALL=C

# ---------------- user settings ----------------
BASE=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/repo
SPECIES=(                    # SPEC CODE  (CODE = exactly 2 letters, unique per species;
  "A.tha at"                 #  MCScanX reads the species from the first two letters of the chr name)
  "O.sat os"
  "G.max gm"
  "Z.mays zm"
)
MCSCANX_OPTS="-s 5 -b 2"     # -s = min genes per block; -b 2 = inter-species blocks only
FORCE=${FORCE:-0}
# -----------------------------------------------

ml purge
module load Miniforge3  # adjust to your cluster; MCScanX: module, bioconda (mcscanx) or build from source
conda activate mcscan

for t in gffread seqkit diamond MCScanX; do
    command -v "$t" >/dev/null || { echo "ERROR: $t not on PATH" >&2; exit 1; }
done

SPDIR=$BASE/synteny/species
mkdir -p "$SPDIR"

# sanity: codes must be unique and 2 letters
declare -A CODEOF
SPECS=()
for entry in "${SPECIES[@]}"; do
    read -r S C <<< "$entry"
    [[ ${#C} -eq 2 ]] || { echo "ERROR: code '$C' for $S is not 2 letters" >&2; exit 1; }
    for other in "${!CODEOF[@]}"; do
        [[ "${CODEOF[$other]}" != "$C" ]] || { echo "ERROR: duplicate code $C ($S, $other)" >&2; exit 1; }
    done
    CODEOF[$S]=$C
    SPECS+=("$S")
done

# ---------- 1. Per species: longest-isoform proteins (named by GENE id) + MCScanX gene coordinates ----------
prep_species () {
    local SPEC=$1 CODE=$2
    local IN=$BASE/$SPEC/01_inputs
    local FA=$IN/$SPEC.chromosomes.fa GTF=$IN/${SPEC}_mRNA.gtf
    local OUTS=$SPDIR/$SPEC

    if [ "$FORCE" != 1 ] && [ -s "$OUTS/$SPEC.prot.fa" ] && [ -s "$OUTS/$SPEC.gff" ]; then
        echo "[$(date)] prep: $SPEC already done, skipping"
        return 0
    fi
    [ -f "$FA" ] && [ -f "$GTF" ] || { echo "ERROR: missing $FA or $GTF" >&2; exit 1; }

    mkdir -p "$OUTS"
    echo "[$(date)] prep: $SPEC ($CODE)"

    # transcript -> gene map from the GTF
    awk -F'\t' '$9 ~ /transcript_id/ && $9 ~ /gene_id/ {
            match($9,/gene_id "[^"]+"/);       g=substr($9,RSTART+9,RLENGTH-10);
            match($9,/transcript_id "[^"]+"/); t=substr($9,RSTART+15,RLENGTH-16);
            print t "\t" g }' "$GTF" | sort -u > "$OUTS/$SPEC.tx2gene.tsv"

    # one protein per transcript, then keep the longest per gene and rename it to the gene id
    gffread "$GTF" -g "$FA" -y "$OUTS/$SPEC.prot_all.fa"
    seqkit seq -w 0 "$OUTS/$SPEC.prot_all.fa" | awk -F'\t' '
        NR==FNR { g[$1]=$2; next }
        /^>/    { id=substr($0,2); sub(/[ \t].*/,"",id); gene=g[id]; next }
                { s=$0; gsub(/[*.]/,"",s);
                  if (gene!="" && length(s)>best[gene]) { best[gene]=length(s); seq[gene]=s } }
        END     { for (k in seq) print ">" k "\n" seq[k] }' "$OUTS/$SPEC.tx2gene.tsv" - > "$OUTS/$SPEC.prot.fa"

    # MCScanX gff: <code><chr>  gene  start  end   (chr label = old name without a leading chr/Chr)
    awk -F'\t' -v OFS='\t' -v code="$CODE" '$3=="exon" {
            match($9,/gene_id "[^"]+"/); g=substr($9,RSTART+9,RLENGTH-10);
            if (!(g in s) || $4+0 < s[g]) s[g]=$4+0;
            if (!(g in e) || $5+0 > e[g]) e[g]=$5+0;
            c[g]=$1 }
        END { for (g in c) { chr=c[g]; sub(/^[Cc][Hh][Rr]/,"",chr); print code chr, g, s[g], e[g] } }' "$GTF" \
        | sort -k1,1 -k3,3n > "$OUTS/$SPEC.gff"

    echo "$SPEC: $(grep -c '>' "$OUTS/$SPEC.prot.fa") proteins | $(wc -l < "$OUTS/$SPEC.gff") genes in gff"
    echo "$SPEC chr labels: $(cut -f1 "$OUTS/$SPEC.gff" | sort -u | head -n 12 | tr '\n' ' ')..."
}

for S in "${SPECS[@]}"; do
    prep_species "$S" "${CODEOF[$S]}"
done

# ---------- 2. Pairwise synteny (all unordered pairs) ----------
run_pair () {
    local SP1=$1 CODE1=$2 SP2=$3 CODE2=$4
    local PAIR=${SP1}_vs_${SP2} TAG=${CODE1}_${CODE2}
    local OUT=$BASE/synteny/$PAIR

    if [ "$FORCE" != 1 ] && [ -s "$OUT/$TAG.collinearity" ]; then
        echo "[$(date)] $PAIR already done, skipping"
        return 0
    fi
    mkdir -p "$OUT"; cd "$OUT"
    echo "[$(date)] $PAIR  (codes: $CODE1 / $CODE2)"

    cat "$SPDIR/$SP1/$SP1.gff"     "$SPDIR/$SP2/$SP2.gff"     > "$TAG.gff"
    cat "$SPDIR/$SP1/$SP1.prot.fa" "$SPDIR/$SP2/$SP2.prot.fa" > all.prot.fa

    # all-vs-all protein search (within AND between species, top 5 hits)
    diamond makedb --in all.prot.fa -d all.prot --threads "$SLURM_CPUS_PER_TASK"
    diamond blastp -d all.prot -q all.prot.fa -o "$TAG.blast" --outfmt 6 -k 5 -e 1e-10 \
        --more-sensitive --threads "$SLURM_CPUS_PER_TASK"

    # every gene id in the BLAST file must exist in the gff
    local MISS
    MISS=$(cut -f1,2 "$TAG.blast" | tr '\t' '\n' | sort -u | comm -23 - <(cut -f2 "$TAG.gff" | sort -u) | wc -l || true)
    echo "BLAST gene ids missing from $TAG.gff: $MISS"
    [ "$MISS" -eq 0 ] || echo "WARNING: gene id mismatch between BLAST and gff" >&2

    # MCScanX
    MCScanX $MCSCANX_OPTS "$OUT/$TAG"

    echo "--- result $PAIR ---"
    echo "blocks: $(grep -c '^## Alignment' "$TAG.collinearity" || true)"
    grep -E '^# Number of collinear genes' "$TAG.collinearity" || true
    echo "[$(date)] done -> $OUT/$TAG.collinearity"
}

N=${#SPECS[@]}
for ((i=0; i<N; i++)); do
    for ((j=i+1; j<N; j++)); do
        S1=${SPECS[$i]}; S2=${SPECS[$j]}
        run_pair "$S1" "${CODEOF[$S1]}" "$S2" "${CODEOF[$S2]}"
    done
done

echo "[$(date)] all pairs finished"
echo "next, for each pair: Rscript 21_lncRNA_synteny.R --base $BASE --sp1 <SP1> --code1 <CODE1> --sp2 <SP2> --code2 <CODE2>"

#!/bin/bash --login
#SBATCH --job-name=prep_inputs
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=/path/to/working/dir/species/%x_%j.out
#SBATCH --error=/path/to/working/dir/species/%x_%j.err

set -euo pipefail
export LC_ALL=C

# ---------------- user settings ----------------
BASE=/path/to/working/dir
SPEC=species                 # e.g. A.tha
CHR_PREFIX=chr               # nuclear chromosomes -> <prefix><N>; set empty for plain 1,2,3
INCLUDE_ANTISENSE=yes        # yes/no: antisense_RNA transcripts count as lncRNAs
RAW_DIR=$BASE/$SPEC/01_inputs/ncbi_dataset/data
# -----------------------------------------------

module load AGAT
module load SeqKit

OUT=$BASE/$SPEC/01_inputs          # deliverables
TMP=$OUT/AGAT                      # intermediates / extras
mkdir -p "$TMP"
cd "$TMP"                          # AGAT writes its logs into the cwd

GFF_IN=$(ls "$RAW_DIR"/*/genomic.gff 2>/dev/null | head -n1 || true)
FASTA_IN=$(ls "$RAW_DIR"/*/*_genomic.fna 2>/dev/null | head -n1 || true)
[ -f "$GFF_IN" ] && [ -f "$FASTA_IN" ] || { echo "ERROR: genomic.gff / *_genomic.fna not found under $RAW_DIR" >&2; exit 1; }
echo "[$(date)] species=$SPEC"; echo "GFF: $GFF_IN"; echo "FASTA: $FASTA_IN"

# deliverables
NUC_FA=$OUT/${SPEC}.chromosomes.fa
MRNA_GTF=$OUT/${SPEC}_mRNA.gtf
KARYO=$OUT/${SPEC}.karyotype.txt
LNC_GFF=$OUT/${SPEC}.lncRNA.gff3
LNC_FA=$OUT/${SPEC}.lncRNA.fa

# awk helper: attr(attribute_column, key) -> value ("" if absent)
ATTR_FN='function attr(s,k,  t,i,j){ t=";" s; i=index(t,";" k "="); if(!i) return ""; t=substr(t,i+length(k)+2); j=index(t,";"); return j ? substr(t,1,j-1) : t }'

# ---------- 1. Classify sequences (nuclear vs organelle) and build rename map ----------
awk -F'\t' "$ATTR_FN"' !/^#/ && $3=="region" && !seen[$1]++ { print $1 "\t" attr($9,"chromosome") "\t" attr($9,"genome") }' \
    "$GFF_IN" > "$TMP/$SPEC.regions.tsv"
grep '^>' "$FASTA_IN" | sed 's/^>//' | awk '{id=$1; $1=""; sub(/^[ \t]+/,""); print id "\t" $0}' > "$TMP/$SPEC.fasta_headers.tsv"

MAP=$TMP/$SPEC.seqid_map.tsv       # old_id <tab> new_id <tab> nuclear|organelle
awk -F'\t' -v pfx="$CHR_PREFIX" '
  NR==FNR { chrom[$1]=$2; genome[$1]=tolower($3); next }
  { id=$1; desc=tolower($2); g=genome[id];
    org = (g ~ /^(mitochondrion|chloroplast|plastid|apicoplast|chromoplast|kinetoplast|leucoplast|cyanelle|plasmid|hydrogenosome|nucleomorph|proplastid)$/) \
          || (desc ~ /mitochondri|chloroplast|plastid|apicoplast|kinetoplast|plasmid/);
    n++; ids[n]=id; isorg[n]=org;
    nm = (!org && chrom[id]!="") ? pfx chrom[id] : id; name[n]=nm; if(!org) cnt[nm]++ }
  END { for (i=1;i<=n;i++) { nm = (cnt[name[i]]>1) ? ids[i] : name[i];     # ambiguous names fall back to accession
          print ids[i] "\t" nm "\t" (isorg[i] ? "organelle" : "nuclear") } }' \
  "$TMP/$SPEC.regions.tsv" "$TMP/$SPEC.fasta_headers.tsv" > "$MAP"
echo "--- sequence map ---"; cat "$MAP"
[ "$(awk -F'\t' '$3=="nuclear"' "$MAP" | wc -l)" -gt 0 ] || { echo "ERROR: no nuclear sequences identified" >&2; exit 1; }

# ---------- 2. Deliverable: nuclear assembly (headers = new IDs only) ----------
awk 'NR==FNR{ if($3=="nuclear") m[$1]=$2; next }
     /^>/ { id=substr($1,2); keep=(id in m); if(keep) print ">" m[id]; next }
     keep { print }' "$MAP" "$FASTA_IN" > "$NUC_FA"

SIZES=$TMP/$SPEC.chrom.sizes
seqkit fx2tab -n -l -i "$NUC_FA" > "$SIZES"           # name <tab> bp

# ---------- 3. Deliverable: karyotype for RIdeogram (nuclear assembly only) ----------
{ printf 'Chr\tStart\tEnd\n'; awk -F'\t' -v OFS='\t' '{print $1, 0, $2}' "$SIZES"; } > "$KARYO"
echo "--- nuclear assembly ---"
awk -F'\t' '{t+=$2} END{printf "sequences: %d\ntotal bp: %d\n", NR, t}' "$SIZES"

# ---------- 4. Rename GFF to match, keep nuclear only, clean with AGAT ----------
GFF_NUC=$TMP/$SPEC.nuclear.renamed.gff3
awk -F'\t' -v OFS='\t' 'NR==FNR{ if($3=="nuclear") m[$1]=$2; next }
     /^##gff-version/{print;next} /^#/{next}
     ($1 in m){ $1=m[$1]; print }' "$MAP" "$GFF_IN" > "$GFF_NUC"

CLEAN=$TMP/$SPEC.clean.gff3
agat_convert_sp_gxf2gxf.pl -g "$GFF_NUC" -o "$CLEAN"
echo "--- feature types (clean GFF) ---"; grep -v '^#' "$CLEAN" | cut -f3 | sort | uniq -c
echo "--- sources (rows from 'AGAT' = features AGAT had to invent) ---"; grep -v '^#' "$CLEAN" | cut -f2 | sort | uniq -c

# ---------- 5. Deliverable: mRNA-only GTF ----------
# gene models whose transcripts are mRNA: gene line + mRNA + exon/CDS/UTR. Nothing else.
MRNA_GFF=$TMP/$SPEC.mRNA.gff3
awk -F'\t' "$ATTR_FN"'
  NR==FNR { if (!/^#/ && $3=="mRNA") { id=attr($9,"ID"); if (id!="") { tx[id]=1; g[attr($9,"Parent")]=1 } } next }
  /^#/ { print; next }
  $3=="gene" { if (attr($9,"ID") in g) print; next }
  $3=="mRNA" { print; next }
  { p=attr($9,"Parent"); if (p!="" && (p in tx)) print }' "$CLEAN" "$CLEAN" > "$MRNA_GFF"
agat_convert_sp_gff2gtf.pl --gff "$MRNA_GFF" -o "$MRNA_GTF"

# ---------- 6. Deliverables: lncRNA GFF3 + sequences (unfiltered) ----------
LNC_TX=$TMP/$SPEC.lnc_transcript_ids.txt; LNC_G=$TMP/$SPEC.lnc_gene_ids.txt
: > "$LNC_TX"; : > "$LNC_G"
# transcript-level selection: lnc_RNA, antisense_RNA (optional), and generic 'transcript' under lncRNA-flagged genes.
awk -F'\t' -v anti="$INCLUDE_ANTISENSE" -v txf="$LNC_TX" -v gf="$LNC_G" "$ATTR_FN"'
  !/^#/ { id=attr($9,"ID"); par=attr($9,"Parent"); if (id=="") next;
          if ($3=="gene") { if (attr($9,"gene_biotype")=="lncRNA") lncgene[id]=1 }
          else if ($3=="lnc_RNA" || ($3=="antisense_RNA" && anti=="yes")) tx[id]=par
          else if ($3=="transcript") cand[id]=par }
  END { for (i in cand) if (cand[i] in lncgene) tx[i]=cand[i];
        for (i in tx) { print i > txf; print tx[i] > gf } }' "$CLEAN"
sort -u "$LNC_G" -o "$LNC_G"
[ -s "$LNC_TX" ] || { echo "ERROR: no lncRNA transcripts found; check feature types above" >&2; exit 1; }

# keep those transcripts + their exons + their gene line (this drops any mRNA/CDS/UTR siblings automatically)
awk -F'\t' -v txf="$LNC_TX" -v gf="$LNC_G" "$ATTR_FN"'
  FILENAME==txf { tx[$1]=1; next }
  FILENAME==gf  { g[$1]=1; next }
  /^#/ { print; next }
  $3=="gene" { if (attr($9,"ID") in g) print; next }
  { id=attr($9,"ID"); par=attr($9,"Parent"); if ((id in tx) || (par in tx)) print }' \
  "$LNC_TX" "$LNC_G" "$CLEAN" > "$LNC_GFF"

echo "lnc_RNA in raw GFF: $(awk -F'\t' '!/^#/ && $3=="lnc_RNA"' "$GFF_IN" | wc -l) | on nuclear contigs: $(awk -F'\t' '!/^#/ && $3=="lnc_RNA"' "$CLEAN" | wc -l)"
echo "--- feature types (lncRNA GFF) ---"; grep -v '^#' "$LNC_GFF" | cut -f3 | sort | uniq -c

# spliced sequences. Symlink so AGAT's FASTA index lands in AGAT/, not 01_inputs/
ln -sf "$NUC_FA" "$TMP/$SPEC.nuclear.fa"
agat_sp_extract_sequences.pl -g "$LNC_GFF" -f "$TMP/$SPEC.nuclear.fa" -t exon --merge -o "$LNC_FA"
find "$OUT" -maxdepth 1 -name "$SPEC.nuclear.fa.*" -exec mv {} "$TMP"/ \;

# ---------- 7. Sanity checks ----------
check_ids () {
    local f=$1 bad
    bad=$(grep -v '^#' "$f" | cut -f1 | sort -u | comm -23 - <(cut -f1 "$SIZES" | sort -u) | wc -l || true)
    echo "$(basename "$f"): seqids not in nuclear.fa = $bad"
    [ "$bad" -eq 0 ] || echo "WARNING: $f has sequence names missing from $NUC_FA" >&2
}
check_ids "$MRNA_GTF"; check_ids "$LNC_GFF"

echo "--- mRNA GTF feature types ---"; grep -v '^#' "$MRNA_GTF" | cut -f3 | sort | uniq -c
echo "exon lines missing gene_id/transcript_id: $(grep -v '^#' "$MRNA_GTF" | awk -F'\t' '$3=="exon" && ($9!~/gene_id/ || $9!~/transcript_id/)' | wc -l)"
if grep -v '^#' "$LNC_GFF" | cut -f3 | grep -qwE 'mRNA|CDS'; then echo "WARNING: mRNA/CDS present in $LNC_GFF" >&2; fi

N_TX=$(grep -c . "$LNC_TX" || true); N_FA=$(grep -c '>' "$LNC_FA" || true)
echo "lncRNA transcripts selected: $N_TX | sequences extracted: $N_FA"
[ "$N_TX" -eq "$N_FA" ] || echo "WARNING: transcript/sequence counts differ" >&2
seqkit stats "$NUC_FA" "$LNC_FA"

echo "--- deliverables in $OUT ---"
ls -lh "$MRNA_GTF" "$NUC_FA" "$KARYO" "$LNC_GFF" "$LNC_FA"
echo "[$(date)] done"
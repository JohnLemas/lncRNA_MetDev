#!/bin/bash
#SBATCH --job-name=extract_rna
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00

set -euo pipefail

# ---------------- User Settings ----------------
BASE="/path/to/working/dir"
SPEC="species"                 # e.g. g.max, z.mays, A.tha
INCLUDE_ANTISENSE=yes        # yes/no: keep antisense_RNA features if present

# Paths to raw NCBI download
DATASETS=$(ls -d $BASE/$SPEC/ncbi_dataset/data/*/)
GFF_RAW=${DATASETS}/genomic.gff
FASTA_RAW=${DATASETS}/*_genomic.fna
# -----------------------------------------------

module load AGAT
module load SeqKit

# Directory setup
CLEAN_DIR=$BASE/$SPEC/01_inputs/AGAT
OUT_DIR=$BASE/$SPEC/01_inputs
mkdir -p "$CLEAN_DIR" "$OUT_DIR"

echo "[$(date)] Starting processing for species: $SPEC"

# ==============================================================================
# STEP 1: Parse Chromosomes & Rename FASTA + GFF
# ==============================================================================
MAP_FILE=$CLEAN_DIR/chr_map.tsv
FASTA_CHR=$CLEAN_DIR/$SPEC.chromosomes.fa
GFF_CHR=$CLEAN_DIR/$SPEC.chromosomes.gff3

echo "--> STEP 1: Renaming accession IDs to chr1, chr2, etc..."

grep "^>" $FASTA_RAW | awk '
/chromosome/ {
    acc = $1; sub(/^>/, "", acc);
    for(i=1; i<=NF; i++) {
        if ($i ~ /^chromosome$/) {
            num = $(i+1);
            gsub(/[^A-Za-z0-9]/, "", num);
            print acc "\tchr" num;
            break;
        }
    }
}' > "$MAP_FILE"

if [ ! -s "$MAP_FILE" ]; then
    echo "ERROR: Could not parse chromosome names from $FASTA_RAW" >&2
    exit 1
fi

seqkit replace -p '^(\S+).*' -r '{kv}' -k "$MAP_FILE" "$FASTA_RAW" > "$FASTA_CHR"

awk -F'\t' -v map="$MAP_FILE" '
BEGIN {
    while ((getline < map) > 0) chr[$1] = $2;
    OFS="\t";
}
/^#/ { next }
$1 in chr {
    $1 = chr[$1];
    print $0;
}' "$GFF_RAW" > "$GFF_CHR"


# ==============================================================================
# STEP 2: Standardize Full Annotations with AGAT
# ==============================================================================
echo "--> STEP 2: Standardizing master GFF3..."
CLEAN_GFF=$CLEAN_DIR/$SPEC.clean.gff3
agat_convert_sp_gxf2gxf.pl \
    -g "$GFF_CHR" \
    -o "$CLEAN_GFF" \
    --log "$CLEAN_DIR/$SPEC.clean.agat.log"


# ==============================================================================
# STEP 3: Process mRNA Branch
# ==============================================================================
echo "--> STEP 3: Extracting mRNA GTF and Spliced FASTA..."

MRNA_GTF=$OUT_DIR/$SPEC.mRNA.gtf
MRNA_FA=$OUT_DIR/$SPEC.mRNA.fa

agat_sp_filter_feature_by_attribute_value.pl \
    --gff "$CLEAN_GFF" \
    --attribute biotype --value mRNA \
    -o "$MRNA_GTF" \
    --log "$CLEAN_DIR/$SPEC.mrna_filter.agat.log"

agat_sp_extract_sequences.pl \
    -g "$MRNA_GTF" \
    -f "$FASTA_CHR" \
    -t exon --merge \
    -o "$MRNA_FA" \
    --log "$CLEAN_DIR/$SPEC.mrna_seq.agat.log"


# ==============================================================================
# STEP 4: Process Reference lncRNA Branch (Unfiltered)
# ==============================================================================
echo "--> STEP 4: Extracting unfiltered reference lncRNAs..."

IDS=$CLEAN_DIR/ref_lncRNA_gene_ids.txt
: > "$IDS"

# Pull parent gene IDs for all lnc_RNA / antisense_RNA features
awk -F'\t' '$3=="lnc_RNA"{if(match($9,/Parent=[^;]+/)) print substr($9,RSTART+7,RLENGTH-7)}' "$CLEAN_GFF" >> "$IDS"
awk -F'\t' '$3=="gene" && $9~/gene_biotype=lncRNA/{if(match($9,/ID=[^;]+/)) print substr($9,RSTART+3,RLENGTH-3)}' "$CLEAN_GFF" >> "$IDS"

if [ "$INCLUDE_ANTISENSE" = "yes" ]; then
    awk -F'\t' '$3=="antisense_RNA"{if(match($9,/Parent=[^;]+/)) print substr($9,RSTART+7,RLENGTH-7)}' "$CLEAN_GFF" >> "$IDS"
fi

sort -u "$IDS" -o "$IDS"

LNC_GTF=$OUT_DIR/$SPEC.lncRNA.gtf
LNC_FA=$OUT_DIR/$SPEC.lncRNA.fa

if [ ! -s "$IDS" ]; then
    echo "WARNING: No annotated lncRNAs found for $SPEC."
    touch "$LNC_GTF" "$LNC_FA"
else
    # Extract complete reference lncRNA feature set to GTF
    agat_sp_filter_feature_from_keep_list.pl \
        --gff "$CLEAN_GFF" \
        --keep_list "$IDS" \
        -o "$LNC_GTF" \
        --log "$CLEAN_DIR/$SPEC.lnc_filter.agat.log"

    # Extract exact spliced FASTA sequences directly from reference GTF
    agat_sp_extract_sequences.pl \
        -g "$LNC_GTF" \
        -f "$FASTA_CHR" \
        -t exon --merge \
        -o "$LNC_FA" \
        --log "$CLEAN_DIR/$SPEC.lnc_seq.agat.log"
fi


# ==============================================================================
# STEP 5: Output Summary
# ==============================================================================
echo "================================================="
echo " PROCESSING COMPLETE"
echo " Final Outputs in $OUT_DIR:"
echo "  - mRNA GTF    : $MRNA_GTF"
echo "  - mRNA FASTA  : $MRNA_FA"
echo "  - lncRNA GTF  : $LNC_GTF"
echo "  - lncRNA FASTA: $LNC_FA"
echo "================================================="
seqkit stats "$MRNA_FA" "$LNC_FA"
echo "[$(date)] Finished successfully."
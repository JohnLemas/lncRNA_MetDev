#!/bin/bash
#SBATCH --job-name=extract_rna
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00

set -euo pipefail

# ---------------- User Settings ----------------
BASE="/path/to/working/dir"
SPEC="species"                 # e.g. g.max, z.mays, A.tha
INCLUDE_ANTISENSE=yes        # yes/no: keep antisense_RNA features if present

# Paths to raw NCBI download
DATASETS=$(ls -d $BASE/$SPEC/ncbi_dataset/data/*/)
GFF_RAW=${DATASETS}/genomic.gff
FASTA_RAW=${DATASETS}/*_genomic.fna
# -----------------------------------------------

module load AGAT
module load SeqKit

# Directory setup
CLEAN_DIR=$BASE/$SPEC/01_inputs/AGAT
OUT_DIR=$BASE/$SPEC/01_inputs
mkdir -p "$CLEAN_DIR" "$OUT_DIR"

echo "[$(date)] Starting processing for species: $SPEC"

# ==============================================================================
# DELIVERABLE 1: Clean Assembly & Master GTF (For STAR genomeGenerate)
# ==============================================================================
MAP_FILE=$CLEAN_DIR/chr_map.tsv
FASTA_CHR=$OUT_DIR/$SPEC.chromosomes.fa
GFF_CHR=$CLEAN_DIR/$SPEC.chromosomes.gff3
MASTER_GTF=$OUT_DIR/$SPEC.chromosomes.gtf

echo "--> STEP 1: Building renamed chromosome-level assembly and master GTF..."

# Parse accession to chrN mappings from FASTA headers
grep "^>" $FASTA_RAW | awk '
/chromosome/ {
    acc = $1; sub(/^>/, "", acc);
    for(i=1; i<=NF; i++) {
        if ($i ~ /^chromosome$/) {
            num = $(i+1);
            gsub(/[^A-Za-z0-9]/, "", num);
            print acc "\tchr" num;
            break;
        }
    }
}' > "$MAP_FILE"

if [ ! -s "$MAP_FILE" ]; then
    echo "ERROR: Could not parse chromosome names from $FASTA_RAW" >&2
    exit 1
fi

# 1a. Write Chromosome-only FASTA with updated chrN headers
seqkit replace -p '^(\S+).*' -r '{kv}' -k "$MAP_FILE" "$FASTA_RAW" > "$FASTA_CHR"

# 1b. Filter raw GFF to retain only primary chromosomes
awk -F'\t' -v map="$MAP_FILE" '
BEGIN {
    while ((getline < map) > 0) chr[$1] = $2;
    OFS="\t";
}
/^#/ { next }
$1 in chr {
    $1 = chr[$1];
    print $0;
}' "$GFF_RAW" > "$GFF_CHR"

# 1c. Standardize and output Master GTF directly to 01_inputs (for STAR)
agat_convert_sp_gxf2gxf.pl \
    -g "$GFF_CHR" \
    -o "$MASTER_GTF" \
    --log "$CLEAN_DIR/$SPEC.master_gtf.agat.log"

# Internal clean GFF3 copy for downstream AGAT queries
CLEAN_GFF=$CLEAN_DIR/$SPEC.clean.gff3
agat_convert_sp_gxf2gxf.pl \
    -g "$GFF_CHR" \
    -o "$CLEAN_GFF" \
    --log "$CLEAN_DIR/$SPEC.clean.agat.log"


# ==============================================================================
# DELIVERABLE 2: Pure mRNA GTF
# ==============================================================================
echo "--> STEP 2: Extracting pure mRNA GTF..."

MRNA_GTF=$OUT_DIR/$SPEC.mRNA.gtf

# Filter master annotation down to mRNA features only and format as GTF
agat_sp_filter_feature_by_attribute_value.pl \
    --gff "$CLEAN_GFF" \
    --attribute biotype --value mRNA \
    -o "$MRNA_GTF" \
    --log "$CLEAN_DIR/$SPEC.mrna_filter.agat.log"


# ==============================================================================
# DELIVERABLE 3: Unfiltered Reference lncRNA GFF & Spliced FASTA
# ==============================================================================
echo "--> STEP 3: Extracting complete, unfiltered reference lncRNAs..."

IDS=$CLEAN_DIR/ref_lncRNA_gene_ids.txt
: > "$IDS"

# Capture all reference-annotated lnc_RNA / antisense_RNA gene IDs
awk -F'\t' '$3=="lnc_RNA"{if(match($9,/Parent=[^;]+/)) print substr($9,RSTART+7,RLENGTH-7)}' "$CLEAN_GFF" >> "$IDS"
awk -F'\t' '$3=="gene" && $9~/gene_biotype=lncRNA/{if(match($9,/ID=[^;]+/)) print substr($9,RSTART+3,RLENGTH-3)}' "$CLEAN_GFF" >> "$IDS"

if [ "$INCLUDE_ANTISENSE" = "yes" ]; then
    awk -F'\t' '$3=="antisense_RNA"{if(match($9,/Parent=[^;]+/)) print substr($9,RSTART+7,RLENGTH-7)}' "$CLEAN_GFF" >> "$IDS"
fi

sort -u "$IDS" -o "$IDS"

LNC_GFF=$OUT_DIR/$SPEC.lncRNA.gff
LNC_FA=$OUT_DIR/$SPEC.lncRNA.fa

if [ ! -s "$IDS" ]; then
    echo "WARNING: No annotated lncRNAs found in reference for $SPEC."
    touch "$LNC_GFF" "$LNC_FA"
else
    # Extract original, unfiltered reference lncRNA annotations as GFF
    agat_sp_filter_feature_from_keep_list.pl \
        --gff "$CLEAN_GFF" \
        --keep_list "$IDS" \
        -o "$LNC_GFF" \
        --log "$CLEAN_DIR/$SPEC.lnc_filter.agat.log"

    # Extract spliced nucleotide sequences for reference lncRNAs
    agat_sp_extract_sequences.pl \
        -g "$LNC_GFF" \
        -f "$FASTA_CHR" \
        -t exon --merge \
        -o "$LNC_FA" \
        --log "$CLEAN_DIR/$SPEC.lnc_seq.agat.log"
fi


# ==============================================================================
# Summary
# ==============================================================================
echo "================================================="
echo " PROCESSING COMPLETE"
echo " Final Deliverables in $OUT_DIR:"
echo "  1. Primary Genome FASTA : $FASTA_CHR"
echo "  2. Master GTF (STAR)    : $MASTER_GTF"
echo "  3. mRNA GTF             : $MRNA_GTF"
echo "  4. Reference lncRNA GFF : $LNC_GFF"
echo "  5. Reference lncRNA FA  : $LNC_FA"
echo "================================================="
seqkit stats "$FASTA_CHR" "$LNC_FA"
echo "[$(date)] Finished successfully."
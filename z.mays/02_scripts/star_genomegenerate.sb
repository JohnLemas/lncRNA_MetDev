#!/bin/bash --login
#SBATCH --job-name=z.mays_star_idx
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=45G
#SBATCH --time=01:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/z.mays/logs/%x-%j.SLURMout

# Paths
BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"
GENOME="${BASE}/z.mays/01_inputs/z.mays.chromosomes.fa"
ANNO="${BASE}/z.mays/01_inputs/z.mays_mRNA.gtf"
INDEX="${BASE}/z.mays/01_inputs/z.mays_indexed"

echo -e ">>>STAR:\n\tRunning build mode.\nInput fasta:\n\t${GENOME}\nInput annotation:\n\t${ANNO}"

echo -e "..making output directory:\n\t${INDEX}"
mkdir -p $INDEX

echo -e "...loading module.."
ml purge
ml load STAR/2.7.11b-GCC-13.2.0

STAR \
     --runMode genomeGenerate \
     --runThreadN $SLURM_CPUS_PER_TASK \
     --genomeDir $INDEX \
     --genomeFastaFiles $GENOME \
     --sjdbGTFfile $ANNO \
     --sjdbGTFtagExonParentTranscript Parent \
     --sjdbOverhang 99 \
     --genomeSAindexNbases 13

echo -e "..process complete. Indexed genome is in\n\t${INDEX}"
#!/bin/bash --login
#SBATCH --job-name=QC
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/z.mays/logs/%x-%j.SLURMout

# Load all required modules at the start
ml purge
ml load FastQC/0.12.1-Java-11
ml load MultiQC

BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"

# ==============================================================================
# 1. QC for FastP Reads
# ==============================================================================
IN_FASTP="${BASE}/z.mays/03_outputs/01_fastp"
OUT_FASTP="${BASE}/z.mays/03_outputs/01_fastp/QC"

mkdir -p "${OUT_FASTP}/multiQC"

# Run FastQC on all fastp gz files
fastqc -t 8 -o "${OUT_FASTP}" "${IN_FASTP}"/*.gz

# Run MultiQC on fastp QC outputs
multiqc "${OUT_FASTP}" -o "${OUT_FASTP}/multiQC"


# ==============================================================================
# 2. QC for Clean (SortMeRNA) Reads
# ==============================================================================
IN_CLEAN="${BASE}/z.mays/03_outputs/02_sortmerna/clean_reads"
OUT_CLEAN="${BASE}/z.mays/03_outputs/02_sortmerna/QC"

mkdir -p "${OUT_CLEAN}/multiQC"

# Run FastQC on clean gz files
fastqc -t 8 -o "${OUT_CLEAN}" "${IN_CLEAN}"/*.gz

# Run MultiQC on clean QC outputs
multiqc "${OUT_CLEAN}" -o "${OUT_CLEAN}/multiQC"
#!/bin/bash --login
#SBATCH --job-name=merge
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/z.mays/logs/%x_%j.out

# ========>-------- Merge assembled GTF files from StringTie into a master GTF file --------<======== #

# 1. Paths
BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"
ID_FILE="${BASE}/z.mays/01_inputs/z.mays_sra_IDs.txt"
GTF_DIR="${BASE}/z.mays/03_outputs/04_stringtie/SRR_assemblies"
REF_GTF="${BASE}/z.mays/01_inputs/z.mays_mRNA.gtf"
OUT_GTF="${BASE}/z.mays/03_outputs/04_stringtie/z.mays_denovo_trans.gtf"

# Load the file IDs into a Bash array
mapfile -t SRA_IDS < "$ID_FILE"

# Create the list of GTF file paths
gtf_filePath=()
for ID in "${SRA_IDS[@]}"; do
    # Only add the file if it actually exists (to prevent StringTie from crashing)
    FILE_PATH="${GTF_DIR}/${ID}_assembled.gtf"
    if [ -f "$FILE_PATH" ]; then
        gtf_filePath+=("$FILE_PATH")
    else
        echo "Warning: $FILE_PATH not found, skipping."
    fi
done

ml purge
ml load StringTie/2.2.1-GCC-11.2.0-Python-2.7.18

# 2. Run the Merge
# --merge: Tells StringTie to combine the list
# -G: Your original reference (keeps known gene names)
# -o: The final master file
# -m: Minimum transcript length to include in the master (200bp)
stringtie --merge -G $REF_GTF -m 200 -o $OUT_GTF ${gtf_filePath[*]}

echo "Master Merge Complete: $OUT_GTF"

# ========>-------- Extract the transcript sequences from the master GTF file --------<======== #

CAN_GTF="${BASE}/z.mays/03_outputs/04_stringtie/z.mays_candidates.gtf"
SEQ_OUT="${BASE}/z.mays/03_outputs/04_stringtie/z.mays_candidates.fasta"
GENOME="${BASE}/z.mays/01_inputs/z.mays.chromosomes.fa"

echo -e "Extracting candidate transcript sequences from $(basename $OUT_GTF)...\n"

grep 'transcript_id "MSTRG' $OUT_GTF > $CAN_GTF

ml purge
ml load gffread

gffread -w $SEQ_OUT -g $GENOME $CAN_GTF

echo -e "Transcript sequence extraction complete:\n$CAN_GTF\n$SEQ_OUT"
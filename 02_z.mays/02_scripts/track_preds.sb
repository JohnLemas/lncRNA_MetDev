#!/bin/bash --login
#SBATCH --job-name=z.mays_track
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G                    # Bumped memory to survive the 165-sample joint matrix generation
#SBATCH --time=00:30:00               # Bumped to 30 mins to account for heavy joint-matrix parsing
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run/z.mays/logs/%x_%j.out

# ========>------- Create tracking files -------<======== #

BASE="/mnt/scratch/lemasjoh/BASF/lncRNA_met_dev/trial_run"
SRR_DIR="${BASE}/z.mays/03_outputs/04_stringtie/SRR_assemblies"
OUT_DIR="${BASE}/z.mays/03_outputs/11_trace"
REF="${BASE}/z.mays/03_outputs/04_stringtie/z.mays_candidates.gtf"
LIST="$OUT_DIR/sra_file_list.txt"

mkdir -p $OUT_DIR

ls -d $SRR_DIR/SRR*_assembled.gtf > $LIST

ml purge
ml load Miniforge3

conda activate gffcompare

gffcompare -r $REF -i $LIST -o $OUT_DIR/candidate

# ========>------- Parse the output files -------<======== #

SCRIPT_DIR="${BASE}/scripts"
TRACK_FILE="$OUT_DIR/candidate.tracking"
FINAL_OUT="$OUT_DIR/z.mays_tracking_summary.tsv"

# Automatically find whichever z.mays lncRNA.fasta file is currently being calculated
# (Matches files inside your parallel 10_intersect directories)
VALIDATED_FASTA="${BASE}/z.mays/03_outputs/10_int_class/z.mays_lncRNA.fasta"

ml purge
ml load SciPy-bundle/eDMFT-intel-2023a # necessary python dependencies

python3 $SCRIPT_DIR/parse_gffcompare_tracking.py \
    -t "$TRACK_FILE" \
    -l "$LIST" \
    -f "$VALIDATED_FASTA" \
    -o "$FINAL_OUT"